{
  "name": "dataexchange",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "pnpm -F @dx/shared build",
    "dev": "pnpm -r --parallel --filter @dx/shared --filter api --filter web dev",
    "build": "pnpm -F @dx/shared build && pnpm -r --filter api --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -F @dx/shared build && pnpm -r typecheck",
    "test": "pnpm -F @dx/shared build && pnpm -r test"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
