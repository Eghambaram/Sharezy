# ─────────────────────────────────────────────────────────────────────────────
# DataExchange — environment configuration
# Copy to `.env` at the repo root. Both apps read this file in local dev.
# Values below are for LOCAL DEVELOPMENT ONLY. The API refuses to start in
# production with AUTH_MODE=dev or with any of the dev-only secrets below.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Origins (no trailing slash). QR codes encode `${APP_ORIGIN}/s/<token>`.
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
API_PORT=4000

# Browser-visible API base URL (inlined into the web bundle at build time).
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://dx:dx_local_only@localhost:5432/dataexchange?schema=public

# Auth: `clerk` (real provider) or `dev` (simulated sign-in, synthetic data, banner shown).
AUTH_MODE=dev
NEXT_PUBLIC_AUTH_MODE=dev
# Signs locally issued dev JWTs. Only used when AUTH_MODE=dev.
DEV_JWT_SECRET=dev-only-jwt-secret-change-me-0000000000000000

# Clerk (required when AUTH_MODE=clerk) — setup guide: docs/auth-setup.md
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZmlybS1nYXplbGxlLTIxNDguY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_z54dVXlq76RTjdzDvDYoWgqMWbmlj1PX6uynBxasbT
# Frontend API JWKS, e.g. https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://firm-gazelle-2148.clerk.accounts.dev/.well-known/jwks.json
# Frontend API URL (the "iss" claim), e.g. https://<your-instance>.clerk.accounts.dev
CLERK_ISSUER=https://firm-gazelle-2148.clerk.accounts.dev
# Optional: only if you add an "aud" claim via a custom session token
CLERK_AUDIENCE=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Share-code HMAC pepper (≥ 32 chars). Generate: openssl rand -base64 48
SHARE_CODE_PEPPER=dev-only-pepper-change-me-000000000000000000000000
# AES-256-GCM key for consent payload snapshots: 32 bytes, base64. Generate: openssl rand -base64 32
DATA_ENC_KEY=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0wMDAwMDAwMDA=
DATA_ENC_KEY_ID=dev-1

# TTL defaults (minutes). QR: 5–30, default 15. Share code: fixed 5.
QR_TTL_MINUTES=15
CODE_TTL_MINUTES=5
